# Cloudflare Pages 响应头。页面里的 <meta> 也有同样的内容安全策略（便于本地打开时生效），
# 这里额外加上只能通过响应头设置的 frame-ancestors。
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'none'; form-action 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=()
